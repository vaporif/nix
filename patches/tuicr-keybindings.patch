@@ -2878,3 +2878,29 @@ fn should_discard_stale_remote_threads_event_after_switching_pr() {
     // then — stale result was dropped
     assert!(app.forge_review_threads.is_empty());
 }
+
+#[test]
+fn comment_vim_shift_z_saves_or_cancels() {
+    let mut app = build_app();
+    app.comment_vim_enabled = true;
+    app.enter_review_comment_mode();
+
+    // ZZ == :w; an empty comment is rejected, so the box stays open.
+    assert!(app.comment_vim_shift_z('Z'));
+    assert_eq!(app.comment_vim_pending, CommentVimPending::ShiftZ);
+    assert_eq!(
+        app.comment_vim_mode_label(),
+        Some(("ZZ save · ZQ cancel".to_string(), false))
+    );
+    assert!(app.comment_vim_shift_z('Z'));
+    assert_eq!(app.comment_vim_pending, CommentVimPending::None);
+    assert_eq!(app.input_mode, InputMode::Comment);
+
+    // A lone Q is not part of a sequence and goes to the editor.
+    assert!(!app.comment_vim_shift_z('Q'));
+
+    // ZQ == :q.
+    assert!(app.comment_vim_shift_z('Z'));
+    assert!(app.comment_vim_shift_z('Q'));
+    assert_eq!(app.input_mode, InputMode::Normal);
+}
