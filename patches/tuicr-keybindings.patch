+    /// `ZZ` saves and `ZQ` cancels, as in vim. Returns false when the key is not
+    /// part of the sequence, so it reaches the editor as usual.
+    pub fn comment_vim_shift_z(&mut self, c: char) -> bool {
+        let armed = self.comment_vim_pending == CommentVimPending::ShiftZ;
+        self.comment_vim_pending = CommentVimPending::None;
+        match (c, armed) {
+            ('Z', false) => {
+                self.comment_vim_pending = CommentVimPending::ShiftZ;
+                true
+            }
+            ('Z', true) => {
+                self.save_comment();
+                true
+            }
+            ('Q', true) => {
+                self.exit_comment_mode();
+                true
+            }
+            _ => false,
+        }
+    }
+
     /// Reset the pending double-press state; called when any other key
     /// interrupts the sequence.
     pub fn comment_vim_reset_pending(&mut self) {
